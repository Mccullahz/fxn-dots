# ─────────────────────────────────────────────────────────────
#  zsh
# ─────────────────────────────────────────────────────────────

export ZSH="$HOME/.oh-my-zsh"

# oh-my-posh owns the prompt, so no ZSH_THEME
ZSH_THEME=""

plugins=(
  git
  archlinux
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

eval "$(oh-my-posh init zsh --config "$HOME/.config/ohmyposh/zen.toml")"

# ─── History ────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt append_history
setopt share_history	# across concurrent shells
setopt hist_ignore_all_dups
setopt hist_reduce_blanks
setopt hist_ignore_space

# ─── Path ───────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim

# ─── Listings ───────────────────────────────────────────────
if command -v lsd >/dev/null; then
  alias ls='lsd'
  alias l='ls -l'
  alias la='ls -a'
  alias lla='ls -la'
  alias lt='ls --tree'
fi

# ─── shell tooling ──────────────────────────────────────────
command -v fzf >/dev/null && source <(fzf --zsh)

# ─── quickshell ──────────────────────────────────────────
alias qsc='qs -c fxn ipc call'
alias qsr='qs -c fxn kill; (qs -c fxn &>/dev/null &)'   
alias qsl='qs -c fxn log'                                # tail its log
alias hyprr='hyprctl reload'
alias wall='$HOME/.config/hypr/bin/wallpaper.sh'
alias dots='cd ~/code/playground && ./promote.sh'

# ─── greeting ───────────────────────────────────────────────
if [[ -o interactive && -z "$FXN_SANDBOX" && $SHLVL -le 1 ]]; then
  if command -v pokemon-colorscripts >/dev/null && command -v fastfetch >/dev/null; then
    pokemon-colorscripts --no-title -s -r |
      fastfetch -c "$HOME/.config/fastfetch/config-pokemon.jsonc" \
        --logo-type file-raw --logo-height 10 --logo-width 5 --logo -
  elif command -v fastfetch >/dev/null; then
    fastfetch -c "$HOME/.config/fastfetch/config-compact.jsonc"
  fi
fi
